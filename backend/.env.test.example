# Dedicated PostgreSQL database used ONLY by integration tests.
# The integration suite refuses database names that do not contain "test".
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=banking_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=your_postgres_password

# Instead of the fields above, you may provide one complete URL:
# TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/banking_test
